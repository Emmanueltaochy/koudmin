# api.kivien.re → passerelle Supabase (127.0.0.1:__PORT__). Généré par deploy/vps/installer.sh.
# Seules l'authentification, l'API REST et le temps réel sont publics.
# Le tableau de bord (Studio) n'est accessible que par tunnel SSH.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAINE__;

    client_max_body_size 2m;
    server_tokens off;

    # Temps réel : websocket longue durée.
    location /realtime/v1/ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ~ ^/(auth|rest)/v1/ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
