# api.kivien.re → passerelle Supabase (127.0.0.1:__PORT__). Généré par deploy/vps/installer.sh.
# Seules l'authentification, l'API REST, le temps réel et la fonction « paiement » sont publics.
# La fonction « prelevements » (débits horaires) n'est appelée qu'en local par le VPS.
# Le tableau de bord (Studio) n'est accessible que par tunnel SSH.

# Contre les essais de mots de passe en série, par adresse IP. Large, car beaucoup de mobiles
# réunionnais sortent par la même adresse chez leur opérateur.
limit_req_zone $binary_remote_addr zone=kivien_connexion:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=kivien_inscription:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=kivien_paiement:10m rate=20r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAINE__;

    client_max_body_size 2m;
    server_tokens off;

    # Temps réel : websocket longue durée.
    location /realtime/v1/ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /auth/v1/token {
        limit_req zone=kivien_connexion burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /auth/v1/signup {
        limit_req zone=kivien_inscription burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /rest/v1/rpc/inscrire_lettre {
        limit_req zone=kivien_inscription burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Page Paiement de l'espace pro : enregistrement de carte ou de mandat, choix du mode.
    location = /functions/v1/paiement {
        limit_req zone=kivien_paiement burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    location ~ ^/(auth|rest)/v1/ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
